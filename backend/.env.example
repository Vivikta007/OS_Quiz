# Copy this file to .env and fill in the values from
# Supabase Dashboard -> Project Settings -> API Keys.
# Never commit .env (it's in .gitignore).

SUPABASE_URL=https://your-project-ref.supabase.co

# "Publishable key" (sb_publishable_...) - safe to be public
SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (sb_secret_...) - SERVER ONLY. Bypasses RLS; used only to
# read the questions table, which contains the correct answers.
SUPABASE_SECRET_KEY=

# Gemini API key for the admin "generate questions" feature - SERVER ONLY.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - which Gemini model writes questions (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
